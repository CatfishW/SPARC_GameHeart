 night is here"},{"t":22.43,"e":27.51,"text":"Slow the beat and let it go"},{"t":27.51,"e":34.01,"text":"Like the tide, so soft, so slow"},{"t":34.01,"e":40.09,"text":"Rest now, rest now, gentle heart"},{"t":40.09,"e":43.35,"text":"Mend the pieces, every part"},{"t":43.35,"e":47.75,"text":"Slower, slower, drifting deep"},{"t":47.75,"e":54.13,"text":"Healing comes while we're asleep"},{"t":70.69,"e":74.79,"text":"Muscles soften, breathing calm"},{"t":77.51,"e":81.47,"text":"Moonlight resting in your palm"},{"t":84.13,"e":88.29,"text":"Every beat a lullaby"},{"t":88.29,"e":95.01,"text":"Under quiet silver sky"},{"t":96.77,"e":100.93,"text":"Rest now, rest now, gentle heart"},{"t":100.93,"e":104.21,"text":"Mend the pieces, every part"},{"t":104.21,"e":108.69,"text":"Slower, slower, drifting deep"},{"t":110.21,"e":114.05,"text":"Healing comes while we're asleep"},{"t":118.51,"e":123.79,"text":"Hush now, gentle heart"},{"t":123.79,"e":128.79,"text":"Hush now, gentle heart"}],"sections":[{"t":9.41,"kind":"verse","energy":0.178},{"t":34.01,"kind":"chorus","energy":0.17},{"t":70.69,"kind":"verse","energy":0.443},{"t":96.77,"kind":"chorus","energy":0.435},{"t":118.51,"kind":"outro","energy":0.236}],"energy":[0.177,0.179,0.176,0.166,0.158,0.16,0.16,0.151,0.14,0.13,0.121,0.111,0.098,0.089,0.092,0.107,0.131,0.16,0.171,0.184,0.201,0.225,0.231,0.25,0.282,0.328,0.357,0.377,0.396,0.4,0.397,0.391,0.383,0.405,0.425,0.442,0.443,0.468,0.489,0.48,0.454,0.445,0.454,0.459,0.463,0.461,0.451,0.447,0.432,0.425,0.409,0.404,0.388,0.371,0.379,0.39,0.411,0.423,0.43,0.444,0.455,0.461,0.459,0.456,0.446,0.438,0.428,0.43,0.424,0.415,0.406,0.386,0.364,0.354,0.344,0.336,0.332,0.333,0.339,0.344,0.339,0.331,0.325,0.318,0.304,0.292,0.275,0.264,0.252,0.237,0.223,0.205,0.181,0.156,0.175,0.2,0.224,0.24,0.252,0.267,0.27,0.284,0.289,0.335,0.369,0.406,0.431,0.468,0.507,0.491,0.467,0.44,0.411,0.388,0.365,0.365,0.363,0.364,0.319,0.279,0.289,0.291,0.271,0.236,0.209,0.194,0.223,0.266,0.312,0.354,0.371,0.374,0.374,