# ---- generation intermediates (regenerable; only chosen sources are kept) ----
# music: keep the 14 chosen YuE2 takes + Whisper word-timing caches
/Tools/music/raw/*
!/Tools/music/raw/first_beat_s1101.flac
!/Tools/music/raw/frostbite_s2201.flac
!/Tools/music/raw/sprint_s3301.flac
!/Tools/music/raw/fever_s4401.flac
!/Tools/music/raw/night_tide_s5501.flac
!/Tools/music/raw/symphony_s6602.flac
!/Tools/music/raw/title_theme_s7701.flac
!/Tools/music/raw/control_center_s8801.flac
!/Tools/music/raw/first_beat_inst_s9101.flac
!/Tools/music/raw/frostbite_inst_s9202.flac
!/Tools/music/raw/sprint_inst_s9301.flac
!/Tools/music/raw/fever_inst_s9401.flac
!/Tools/music/raw/night_tide_inst_s9501.flac
!/Tools/music/raw/symphony_inst_s9601.flac
/Tools/music/work/*
!/Tools/music/work/*.words.json
Tools/music/job_*.json

# voice: keep Qwen3-TTS raw takes + QA reports; the mastered WAVs live in Assets/Resources/Voice
/Tools/voice/raw/
/Tools/voice/backups/
/Tools/voice/qwen3/auditions/
/Tools/voice/qwen3/rejected-takes/
